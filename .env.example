# Environment identity. Staging and production must use separate projects,
# databases, Redis instances, OAuth applications, and provider credentials.
APP_ENV="development"
APP_URL="http://localhost:3000"
APP_VERSION="1.0.0"

# Runtime traffic uses the pooled URL. Migrations and administrative jobs use
# the direct URL. Never point staging or production at the local Docker DB.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/xuanxiang?schema=public"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/xuanxiang?schema=public"

# Studio uses Better Auth database sessions and is available only when enabled.
ENABLE_EDITORIAL_STUDIO=false
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"
STUDIO_OAUTH_PROVIDER="github"
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Distributed rate limiting. Required outside development.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Monitoring. DSN is server-only; browser exposure is intentionally disabled.
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Runtime feature switches.
PUBLIC_AI_ENABLED=false
MAINTENANCE_MODE=false
# Production runs on Vercel and trusts only its platform-managed client IP header.
# Generic x-real-ip and x-forwarded-for headers are never trusted.
TRUSTED_PROXY_HEADERS="vercel"
COMMIT_SHA=""

# AI providers are server-only. Chat and embedding configuration are independent.
AI_CHAT_PROVIDER=""
AI_CHAT_MODEL=""
AI_CHAT_BASE_URL=""
AI_CHAT_API_KEY=""
AI_EMBEDDING_PROVIDER=""
AI_EMBEDDING_MODEL=""
AI_EMBEDDING_BASE_URL=""
AI_EMBEDDING_API_KEY=""
AI_EMBEDDING_DIMENSIONS="1536"
AI_CHAT_TIMEOUT_MS="30000"
AI_EMBEDDING_TIMEOUT_MS="20000"
AI_MAX_OUTPUT_TOKENS="1200"

# Deterministic local/test embeddings only. Never enable in production.
AI_ALLOW_TEST_PROVIDER=false
