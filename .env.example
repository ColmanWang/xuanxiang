# PostgreSQL connection string. Copy this file to .env for local development.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/xuanxiang?schema=public"

# Editorial Studio is development-only. Production remains 404 even if this is true.
ENABLE_EDITORIAL_STUDIO=false

# AI providers are server-only. Chat and embedding configuration are independent.
AI_CHAT_PROVIDER=""
AI_CHAT_MODEL=""
AI_CHAT_BASE_URL=""
AI_CHAT_API_KEY=""
AI_EMBEDDING_PROVIDER=""
AI_EMBEDDING_MODEL=""
AI_EMBEDDING_BASE_URL=""
AI_EMBEDDING_API_KEY=""
AI_EMBEDDING_DIMENSIONS="1536"

# Deterministic local/test embeddings only. Never enable in production.
AI_ALLOW_TEST_PROVIDER=false
