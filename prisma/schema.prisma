generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Concept {
  id                String          @id
  name              String
  slug              String          @unique
  aliases           String[]        @default([])
  summary           String
  categories        String[]        @default([])
  definition        String?
  historicalContext String?
  development       Json?
  keyIdeas          Json?
  researchNotes     Json?
  content           String?
  editorialStatus   EditorialStatus @default(DRAFT)
  lastReviewedAt    DateTime?
  dynastyId         String?
  dynasty           Dynasty?        @relation(fields: [dynastyId], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([dynastyId])
  @@index([editorialStatus])
}

model Classic {
  id                String            @id
  title             String
  slug              String            @unique
  aliases           String[]          @default([])
  summary           String
  categories        String[]          @default([])
  authorDisplay     String?
  attributionStatus AttributionStatus @default(UNKNOWN)
  period            String?
  contentStructure  Json?
  themes            String[]          @default([])
  historicalContext String?
  influence         String?
  editorialStatus   EditorialStatus   @default(DRAFT)
  lastReviewedAt    DateTime?
  dynastyId         String?
  dynasty           Dynasty?          @relation(fields: [dynastyId], references: [id], onDelete: SetNull)
  witnesses         TextWitness[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([dynastyId])
  @@index([editorialStatus])
}

model Person {
  id                String           @id
  name              String
  slug              String           @unique
  aliases           String[]         @default([])
  summary           String
  categories        String[]         @default([])
  birthYear         Int?
  deathYear         Int?
  period            String?
  role              String?
  keyIdeas          Json?
  historicalContext String?
  influence         String?
  editorialStatus   EditorialStatus  @default(DRAFT)
  lastReviewedAt    DateTime?
  interpretations   Interpretation[] @relation("InterpretationPerson")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([editorialStatus])
}

model School {
  id                   String           @id
  name                 String
  slug                 String           @unique
  aliases              String[]         @default([])
  summary              String
  categories           String[]         @default([])
  period               String?
  coreQuestions        String[]         @default([])
  keyIdeas             Json?
  historicalContext    String?
  development          Json?
  editorialNote        String?
  classificationStatus EvidenceStatus   @default(INFERRED)
  editorialStatus      EditorialStatus  @default(DRAFT)
  lastReviewedAt       DateTime?
  interpretations      Interpretation[] @relation("InterpretationSchool")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([editorialStatus])
}

model Technique {
  id                String          @id
  name              String
  slug              String          @unique
  aliases           String[]        @default([])
  category          String
  summary           String
  categories        String[]        @default([])
  period            String?
  definition        String?
  historicalContext String?
  development       Json?
  keyIdeas          Json?
  toolPath          String?
  editorialStatus   EditorialStatus @default(DRAFT)
  lastReviewedAt    DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([category])
  @@index([editorialStatus])
}

model Dynasty {
  id              String          @id
  name            String          @unique
  slug            String          @unique
  startYear       Int?
  endYear         Int?
  summary         String?
  editorialStatus EditorialStatus @default(BASIC)
  concepts        Concept[]
  classics        Classic[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Source {
  id            String        @id
  type          SourceType
  title         String
  author        String?
  dynastyOrYear String?
  publisher     String?
  edition       String?
  isbn          String?
  url           String?
  note          String?
  citations     Citation[]
  witnesses     TextWitness[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([type])
  @@index([title])
}

model Citation {
  id               String              @id
  sourceId         String
  subjectType      CitationSubjectType
  subjectId        String
  locator          String?
  note             String?
  citationType     CitationType
  evidenceStatus   EvidenceStatus      @default(DOCUMENTED)
  relationId       String?
  interpretationId String?
  passageId        String?
  source           Source              @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  relation         Relation?           @relation(fields: [relationId], references: [id], onDelete: Cascade)
  interpretation   Interpretation?     @relation(fields: [interpretationId], references: [id], onDelete: Cascade)
  passage          TextPassage?        @relation(fields: [passageId], references: [id], onDelete: SetNull)
  createdAt        DateTime            @default(now())

  @@unique([sourceId, subjectType, subjectId, locator, citationType])
  @@index([subjectType, subjectId])
  @@index([sourceId])
  @@index([relationId])
  @@index([interpretationId])
  @@index([passageId])
}

model TextWitness {
  id              String          @id
  classicId       String
  sourceId        String?
  title           String
  shortTitle      String?
  editionType     EditionType
  editor          String?
  publisher       String?
  publicationYear Int?
  description     String?
  isPrimary       Boolean         @default(false)
  editorialStatus EditorialStatus @default(DRAFT)
  classic         Classic         @relation(fields: [classicId], references: [id], onDelete: Cascade)
  source          Source?         @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sections        TextSection[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([classicId, isPrimary])
  @@index([sourceId])
  @@index([editorialStatus])
}

model TextSection {
  id          String        @id
  witnessId   String
  parentId    String?
  slug        String
  title       String
  ordinal     Int
  sectionType String
  depth       Int           @default(0)
  witness     TextWitness   @relation(fields: [witnessId], references: [id], onDelete: Cascade)
  parent      TextSection?  @relation("SectionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    TextSection[] @relation("SectionTree")
  passages    TextPassage[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([witnessId, slug])
  @@index([witnessId, parentId, ordinal])
}

model TextPassage {
  id              String              @id
  sectionId       String
  ordinal         Int
  text            String
  normalizedText  String?
  contentType     PassageContentType  @default(SOURCE_TEXT)
  editorialStatus EditorialStatus     @default(DRAFT)
  section         TextSection         @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  citations       Citation[]
  entityLinks     PassageEntityLink[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([sectionId, ordinal])
  @@index([sectionId, ordinal])
}

model PassageEntityLink {
  id             String              @id
  passageId      String
  entityType     KnowledgeEntityType
  entityId       String
  linkType       PassageLinkType
  note           String?
  evidenceStatus EvidenceStatus      @default(INFERRED)
  passage        TextPassage         @relation(fields: [passageId], references: [id], onDelete: Cascade)
  createdAt      DateTime            @default(now())

  @@unique([passageId, entityType, entityId, linkType])
  @@index([entityType, entityId])
  @@index([passageId])
}

model Interpretation {
  id                   String              @id
  subjectType          KnowledgeEntityType
  subjectId            String
  title                String
  summary              String
  attributedToPersonId String?
  attributedToSchoolId String?
  period               String?
  evidenceStatus       EvidenceStatus      @default(INFERRED)
  editorialStatus      EditorialStatus     @default(DRAFT)
  attributedToPerson   Person?             @relation("InterpretationPerson", fields: [attributedToPersonId], references: [id], onDelete: SetNull)
  attributedToSchool   School?             @relation("InterpretationSchool", fields: [attributedToSchoolId], references: [id], onDelete: SetNull)
  citations            Citation[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([subjectType, subjectId])
  @@index([attributedToPersonId])
  @@index([attributedToSchoolId])
  @@index([editorialStatus])
}

model Relation {
  id             String          @id
  sourceType     GraphEntityType
  sourceId       String
  targetType     GraphEntityType
  targetId       String
  relationType   RelationType
  evidenceStatus EvidenceStatus  @default(INFERRED)
  note           String?
  sourceNote     String?
  legacySources  String[]        @default([])
  citations      Citation[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // sourceId / targetId are polymorphic references. All writes must pass validateRelations().
  // legacySources is transitional and must not receive new formal citations.
  @@unique([sourceType, sourceId, targetType, targetId, relationType])
  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
  @@index([relationType])
  @@index([evidenceStatus])
}

enum KnowledgeEntityType {
  CONCEPT
  PERSON
  CLASSIC
  SCHOOL
  TECHNIQUE
}

enum GraphEntityType {
  CONCEPT
  PERSON
  CLASSIC
  SCHOOL
  TECHNIQUE
  DYNASTY
}

enum RelationType {
  RELATED_TO
  BELONGS_TO
  DERIVED_FROM
  INFLUENCED_BY
  WRITTEN_BY
  APPEARS_IN
  DEVELOPED_DURING
  USES
  INTERPRETS
}

enum EvidenceStatus {
  DOCUMENTED
  TRADITIONAL
  INFERRED
  CONTESTED
}

enum EditorialStatus {
  DRAFT
  BASIC
  SOURCED
  REVIEWED
}

enum SourceType {
  PRIMARY_TEXT
  CLASSICAL_COMMENTARY
  MODERN_BOOK
  ACADEMIC_PAPER
  REFERENCE_WORK
  OTHER
}

enum CitationSubjectType {
  CONCEPT
  CLASSIC
  PERSON
  SCHOOL
  TECHNIQUE
  DYNASTY
  RELATION
  INTERPRETATION
}

enum CitationType {
  DEFINITION
  HISTORICAL_CONTEXT
  ATTRIBUTION
  RELATION_EVIDENCE
  INTERPRETATION
  GENERAL
}

enum AttributionStatus {
  CERTAIN
  TRADITIONAL
  CONTESTED
  ANONYMOUS
  COMPOSITE
  UNKNOWN
}

enum EditionType {
  MANUSCRIPT
  BLOCK_PRINT
  MODERN_COLLATION
  DIGITAL_TRANSCRIPTION
  REFERENCE
}

enum PassageContentType {
  SOURCE_TEXT
  EDITORIAL_NOTE
}

enum PassageLinkType {
  MENTIONS
  DISCUSSES
  DEFINES
  INTERPRETED_AS
  RELATED
}
