{
  "name": "xuanxiang-platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "classics:validate": "tsx scripts/validate-classic-samples.ts",
    "classics:import": "tsx scripts/import-classic-text.ts",
    "calendar:terms": "tsx scripts/calendar-terms.ts",
    "calendar:verify-terms": "tsx scripts/verify-solar-terms.ts",
    "bazi:calculate": "tsx scripts/bazi-calculate.ts",
    "bazi:rules": "tsx scripts/bazi-rules.ts",
    "bazi:verify-foundation": "tsx scripts/verify-bazi-foundation.ts",
    "liuyao:calculate": "tsx scripts/liuyao-calculate.ts",
    "liuyao:rules": "tsx scripts/liuyao-rules.ts",
    "liuyao:verify-foundation": "tsx scripts/verify-liuyao-foundation.ts",
    "liuyao:browser-qa": "tsx scripts/liuyao-browser-qa.ts",
    "content:validate": "tsx scripts/content-validate.ts",
    "content:export": "tsx scripts/content-export.ts",
    "content:import": "tsx scripts/content-import.ts",
    "ai:index": "node --env-file=.env --import tsx scripts/ai-index.ts",
    "ai:status": "node --env-file=.env --import tsx scripts/ai-status.ts",
    "ai:eval": "node --env-file-if-exists=.env --import tsx scripts/ai-eval.ts",
    "ai:smoke": "node --env-file=.env --import tsx scripts/ai-smoke.ts",
    "migration:check": "node --import tsx scripts/phase11/check-migration-integrity.ts",
    "dependency:audit": "node --import tsx scripts/phase11/dependency-audit.ts",
    "launch:readiness": "node --import tsx scripts/launch-readiness.ts",
    "production:smoke": "node --import tsx scripts/production-smoke.ts",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.5",
    "@js-temporal/polyfill": "0.5.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/nextjs": "10.75.0",
    "@upstash/ratelimit": "2.1.0",
    "@upstash/redis": "1.38.4",
    "@xyflow/react": "^12.11.2",
    "better-auth": "1.7.5",
    "dotenv": "17.4.2",
    "lucide-react": "^1.29.0",
    "lunar-typescript": "1.8.6",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.9.0"
